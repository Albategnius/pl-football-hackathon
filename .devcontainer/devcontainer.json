{
  "name": "Producer Co-pilot",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user uv && uv sync",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Producer Console", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot"]
    }
  }
}
