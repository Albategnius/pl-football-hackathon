# Any OpenAI-compatible chat completions API. Leave all three empty to run on
# cached replies and verified template fallbacks only. Model names below are
# examples; check your provider's current model list.
#
#   OpenAI:            LLM_BASE_URL=            LLM_MODEL=gpt-4.1-mini
#   Groq:              LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama (local):    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   (no key needed)
#   Microsoft Foundry: LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/   LLM_MODEL=<deployment name>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Minimum seconds between model calls; raise it for providers with tight rate limits.
LLM_MIN_INTERVAL_S=1.0
# Set to 0 to ignore data/llm_cache.json and always call the model.
LLM_CACHE=1

MATCH_SEED=1
REPLAY_SPEED=15
INJECT_FAULTS=0
