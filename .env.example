# GitHub personal access token with the "models: read" permission (free GitHub Models).
# Without it the app still runs: cached responses first, then verified template fallbacks.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini
# GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference

# Seconds between model calls; the free tier allows roughly 15 requests per minute.
LLM_MIN_INTERVAL_S=4.5
# Set to 0 to ignore data/llm_cache.json and always call the model.
LLM_CACHE=1

MATCH_SEED=1
REPLAY_SPEED=15
INJECT_FAULTS=0
